from openai import OpenAI

# This points to the Ollama "engine" running in your taskbar
client = OpenAI(
    base_url='http://localhost:11434/v1',
    api_key='ollama', # Ollama ignores this, but the library needs a string
)

response = client.chat.completions.create(
  model="llama3.2",
  messages=[
    {"role": "system", "content": "You are a helpful assistant specialized in legacy code refactoring."},
    {"role": "user", "content": "Explain this function: hello_world(print)"}
  ]
)

print(response.choices[0].message.content)